{
  "rewrites": [
    { "source": "/sop", "destination": "/sop.html" },
    { "source": "/((?!sop\\.html$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sop.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
